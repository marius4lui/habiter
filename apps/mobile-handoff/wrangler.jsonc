{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "habiter-mobile-handoff",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mobile.habiter.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  }
}
