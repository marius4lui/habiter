# Habiter Personal Sync Beta requires a reverse proxy with HTTPS for public use.
HABITER_SYNC_BASE_URL=https://sync.example.com
HABITER_SYNC_REDIRECT_URIS=https://app.example.com/auth/callback
HABITER_SYNC_CORS_ORIGINS=https://app.example.com
HABITER_SYNC_INSTANCE_NAME=Habiter Personal Sync Beta

# Keep the published service on loopback behind the reverse proxy.
HABITER_SYNC_BIND_ADDRESS=127.0.0.1
HABITER_SYNC_HOST_PORT=8787
