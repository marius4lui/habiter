{
  "name": "habiter-monorepo",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "docs:check": "npm --prefix docs run docs:check",
    "roadmap:sync": "node scripts/docs/sync-roadmap.mjs",
    "roadmap:check": "node scripts/docs/sync-roadmap.mjs --check",
    "release:validate": "pnpm --filter @habiter/release-core validate",
    "release:test": "pnpm --filter @habiter/release-core test",
    "release:notes": "pnpm --filter @habiter/release-core notes",
    "sync:check": "pnpm --filter @habiter/sync-core check",
    "sync:auth:check": "pnpm --filter @habiter/sync-auth check",
    "sync:http:check": "pnpm --filter @habiter/sync-http check",
    "sync:service:check": "pnpm --filter @habiter/sync-service check",
    "sync:worker:check": "pnpm --filter @habiter/sync-worker check",
    "mobile:handoff:check": "pnpm --filter @habiter/mobile-handoff check",
    "sync:d1:check": "pnpm --filter @habiter/sync-d1 check",
    "sync:docker:check": "node scripts/sync/validate-docker.mjs",
    "sync:sqlite:check": "pnpm --filter @habiter/sync-sqlite check",
    "website:dev": "pnpm --filter @habiter/website dev",
    "website:build": "pnpm --filter @habiter/website build",
    "website:typecheck": "pnpm --filter @habiter/website typecheck",
    "website:deploy:dry": "pnpm --filter @habiter/website deploy:dry",
    "website:check": "node scripts/website/validate.mjs && pnpm website:typecheck && pnpm website:build && pnpm website:deploy:dry"
  }
}
