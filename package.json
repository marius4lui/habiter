{
  "name": "habiter-monorepo",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "release:validate": "pnpm --filter @habiter/release-core validate",
    "release:test": "pnpm --filter @habiter/release-core test",
    "release:notes": "pnpm --filter @habiter/release-core notes",
    "website:dev": "pnpm --filter @habiter/website dev",
    "website:build": "pnpm --filter @habiter/website build",
    "website:typecheck": "pnpm --filter @habiter/website typecheck",
    "website:check": "node scripts/website/validate.mjs && pnpm website:typecheck"
  }
}
