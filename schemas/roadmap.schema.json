{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habiter.dev/schemas/roadmap.schema.json",
  "title": "Habiter roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "description", "releases", "versioning"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release" }
    },
    "versioning": { "$ref": "#/$defs/versioning" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "title", "status", "channel", "summary"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["released", "planned"] },
        "channel": { "enum": ["stable", "beta"] },
        "statusText": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "summary": { "$ref": "#/$defs/stringList" },
        "scope": { "$ref": "#/$defs/stringList" },
        "rationale": { "$ref": "#/$defs/titledList" },
        "note": { "type": "string", "minLength": 1 },
        "implementationOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issue", "title", "items"],
            "properties": {
              "issue": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "items": { "$ref": "#/$defs/stringList" }
            }
          }
        },
        "goal": { "type": "string", "minLength": 1 },
        "testing": { "$ref": "#/$defs/stringList" },
        "dependencies": { "$ref": "#/$defs/stringList" }
      }
    },
    "titledList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "items": { "$ref": "#/$defs/stringList" }
      }
    },
    "versioningEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usedFor", "example"],
      "properties": {
        "usedFor": { "$ref": "#/$defs/stringList" },
        "example": { "type": "string", "minLength": 1 }
      }
    },
    "versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "minor", "major"],
      "properties": {
        "patch": { "$ref": "#/$defs/versioningEntry" },
        "minor": { "$ref": "#/$defs/versioningEntry" },
        "major": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
